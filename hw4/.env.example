# Copy to backend/.env (or hw4/.env) and fill in. Placeholders only; never commit .env.
# On Render, set these as environment variables instead.

# Signs the login session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# AI calls go through Portkey. If these are already set in a .env in a folder above
# (e.g. a course-wide .env), you can leave them out here (the closest .env wins).
PORTKEY_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Leave empty to use data/campus_customs.db. For Supabase, paste the Session pooler
# connection string: postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Deployment only: HTTPS-only cookie, and the site's public address for the CSRF origin check.
# COOKIE_SECURE=true
# ALLOWED_ORIGINS=https://<your-app>.onrender.com
